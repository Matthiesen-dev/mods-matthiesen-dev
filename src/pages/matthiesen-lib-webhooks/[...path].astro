---
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (() => {
    return [
        {
            params: { path: undefined },
        },
        {
            params: { path: "examples" },
        },
        {
            params: { path: "index" },
        },
        {
            params: { path: "installation" },
        },
    ];
}) satisfies GetStaticPaths;
---

<html>
    <head>
        <meta
            http-equiv="refresh"
            content={`0; url=/matthiesen-core-webhooks`}
        />
        <title>Redirecting...</title>
    </head>
    <body>
        <p>
            Redirecting to <a href={`/matthiesen-core-webhooks`}
                >/matthiesen-core-webhooks</a
            >...
        </p>
    </body>
</html>
