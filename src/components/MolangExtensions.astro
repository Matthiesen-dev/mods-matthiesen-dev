---
import { Code } from "@astrojs/starlight/components";
import type { MolangExtensions } from "../types";

interface Props {
    extensions: MolangExtensions;
}

const { extensions } = Astro.props;
---

<section
    class="molang-extensions not-content"
    aria-label="Available Molang extensions"
>
    {
        extensions.length > 0 ? (
            <ul class="molang-extensions-list" role="list">
                {extensions.map((entry) => (
                    <li class="molang-extension-card">
                        <div class="extension-header">
                            <div class="extension-codebox-wrapper">
                                <span class="codebox-label">Function</span>
                                <Code
                                    class="function-codebox"
                                    code={entry.function}
                                    lang={"c"}
                                />
                            </div>
                        </div>

                        {entry.description && (
                            <p class="extension-description">
                                {entry.description}
                            </p>
                        )}

                        <div class="result-row">
                            <span class="result-label">Returns</span>
                            <code class="result-value">{entry.result}</code>
                        </div>
                    </li>
                ))}
            </ul>
        ) : (
            <p class="empty-state">
                No Molang extensions are documented for this module yet.
            </p>
        )
    }
</section>

<style>
    .molang-extensions {
        margin: 1rem 0 1.5rem;
    }

    .molang-extensions-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 0.55rem;
    }

    .molang-extension-card {
        border: 1px solid var(--sl-color-gray-5);
        background: linear-gradient(
            145deg,
            color-mix(
                in srgb,
                var(--sl-color-bg) 90%,
                var(--sl-color-accent) 10%
            ),
            var(--sl-color-bg)
        );
        border-radius: 0.75rem;
        padding: 0.65rem 0.8rem;
        box-shadow: 0 1px 0
            color-mix(in srgb, var(--sl-color-white) 15%, transparent);
    }

    .extension-header {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .extension-codebox-wrapper {
        display: grid;
        gap: 0.18rem;
    }

    .codebox-label,
    .result-label {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--sl-color-gray-2);
    }

    pre.function-codebox {
        white-space: unset;
        margin: 0;
        padding: 0.3rem 0.55rem;
        border-radius: 0.55rem;
        border: 1px solid var(--sl-color-gray-5);
        background: color-mix(
            in srgb,
            var(--sl-color-black) 92%,
            var(--sl-color-gray-6)
        );
        overflow-x: auto;
        min-height: 0;
        display: block;
        box-shadow: inset 0 1px 0
            color-mix(in srgb, var(--sl-color-white) 10%, transparent);
    }

    .function-codebox code {
        display: block;
        margin: 0;
        padding: 0;
        color: var(--sl-color-text);
        font-size: 0.88rem;
        line-height: 1.2;
        white-space: nowrap;
        overflow: visible;
        text-align: left;
    }

    .extension-description {
        margin: 0.35rem 0 0;
        color: var(--sl-color-text);
        line-height: 1.4;
    }

    .result-row {
        margin-top: 0.4rem;
        display: grid;
        gap: 0.18rem;
    }

    .result-value {
        display: block;
        border: 1px dashed var(--sl-color-gray-5);
        border-radius: 0.55rem;
        padding: 0.3rem 0.5rem;
        font-size: 0.85rem;
        line-height: 1.25;
        background: color-mix(in srgb, var(--sl-color-gray-6) 40%, transparent);
        color: var(--sl-color-text);
        overflow-wrap: anywhere;
        white-space: pre-wrap;
    }

    .empty-state {
        margin: 0;
        border: 1px dashed var(--sl-color-gray-5);
        border-radius: 0.7rem;
        padding: 0.9rem 1rem;
        color: var(--sl-color-gray-2);
        background: color-mix(
            in srgb,
            var(--sl-color-bg) 90%,
            var(--sl-color-gray-6) 10%
        );
        font-style: italic;
    }

    @media (max-width: 40rem) {
        .molang-extension-card {
            padding: 0.6rem 0.7rem;
        }

        .function-codebox code,
        .result-value {
            font-size: 0.85rem;
        }
    }
</style>
