---
import { getCollection } from "astro:content";
import Recipe from "./CraftingRecipe.astro";
import SmithingRecipe from "./SmithingRecipe.astro";

const allCraftingRecipes = await getCollection(
    "craftingRecipes",
    (item) => item.data.modFilter === "minecraft",
);

const allSmithingRecipes = await getCollection(
    "smithingRecipes",
    (item) => item.data.modFilter === "minecraft",
);
---

<h1>Crafting Directory</h1>

<div
    class="recipes-list not-content"
    style="display: flex; flex-direction: column; gap: 32px;"
>
    <h2>Crafting Recipes</h2>
    {
        allCraftingRecipes.map((recipe) => (
            <Recipe
                name={recipe.data.name}
                description={recipe.data.description}
                ingredients={recipe.data.ingredients}
                resultItem={recipe.data.resultItem}
                resultCount={recipe.data.resultCount}
            />
        ))
    }

    <h2 style="margin-top: 48px;">Smithing Recipes</h2>
    {
        allSmithingRecipes.map((recipe) => (
            <SmithingRecipe
                name={recipe.data.name}
                description={recipe.data.description}
                template={recipe.data.template ?? null}
                baseItem={recipe.data.baseItem}
                additionItem={recipe.data.additionItem}
                resultItem={recipe.data.resultItem}
            />
        ))
    }
</div>
