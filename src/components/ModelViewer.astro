---
interface ViewerModel {
    name: string;
    path: string;
    animation?: string;
}

interface Props {
    models: ViewerModel[];
    height?: string;
    hideAnimationTools?: boolean;
}

const {
    models = [],
    height = "500px",
    hideAnimationTools = false,
} = Astro.props;

const hasModels = models.length > 0;
const showAnimationTools = !hideAnimationTools;

const basePath = "/models/";
const resolveModelPath = (path: string) => {
    if (
        path.startsWith("/") ||
        path.startsWith("http://") ||
        path.startsWith("https://")
    ) {
        return path;
    }
    return `${basePath}${path}`;
};

const serializedModels = JSON.stringify(
    models.map((model) => ({
        ...model,
        fullPath: resolveModelPath(model.path),
    })),
);
---

<div
    class="model-viewer not-content"
    data-model-viewer
    data-models={serializedModels}
    data-enable-animation-tools={showAnimationTools}
>
    <div class="viewer-header">
        <div class="viewer-title">3D Model Viewer</div>
        <div class="viewer-subtitle">
            Preview and inspect block, item, and entity models
        </div>
    </div>

    <div class="viewer-toolbar">
        <div class="viewer-controls">
        <label class="viewer-select-label">Model</label>
        <div class="custom-select model-select-wrap" data-model-dropdown>
            <button
                type="button"
                class="custom-select-trigger"
                data-model-trigger
                aria-expanded="false"
                disabled={!hasModels}
            >
                {models[0]?.name || "Select model"}
            </button>
            <div class="custom-select-menu" data-model-menu hidden>
                {
                    models.map((model, index) => (
                        <button
                            type="button"
                            class="custom-select-option"
                            data-model-index={index}
                        >
                            {model.name}
                        </button>
                    ))
                }
            </div>
        </div>
            <button
                type="button"
                data-angle-control="left"
                disabled={!hasModels}>Left</button
            >
            <button
                type="button"
                data-angle-control="right"
                disabled={!hasModels}>Right</button
            >
            <button type="button" data-angle-control="up" disabled={!hasModels}
                >Up</button
            >
            <button
                type="button"
                data-angle-control="down"
                disabled={!hasModels}>Down</button
            >
            <button
                type="button"
                data-angle-control="reset"
                disabled={!hasModels}>Reset</button
            >
        </div>
        {
            showAnimationTools && (
                <span class="viewer-toolbar-separator"></span>
                <div class="animation-controls">
                    <label class="viewer-select-label">Animations</label>
                    <div
                        class="custom-select animation-select-wrap"
                        data-animation-dropdown
                        hidden
                    >
                        <button
                            type="button"
                            class="custom-select-trigger"
                            data-animation-trigger
                            aria-expanded="false"
                        >
                            Select animation
                        </button>
                        <div
                            class="custom-select-menu"
                            data-animation-menu
                            hidden
                        />
                    </div>
                    <button
                        type="button"
                        class="animation-label-toggle"
                        data-animation-full-names-toggle
                        aria-pressed="false"
                    >
                        Full names
                    </button>
                </div>
            )
        }
    </div>

    <div
        class="canvas-container"
        style={`height: ${height};`}
        data-canvas-container
    >
        <div class="viewer-hint">Drag to orbit • Scroll to zoom</div>
        <div
            class:list={["viewer-status", !hasModels && "is-visible"]}
            data-viewer-status
        >
            {!hasModels ? "No models available for this page." : ""}
        </div>
    </div>
</div>

