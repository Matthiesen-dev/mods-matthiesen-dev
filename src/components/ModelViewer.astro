</style>

<script>
    import * as THREE from "three";
    import { OrbitControls } from "three/examples/jsm/controls/OrbitControls.js";
    import { GLTFLoader } from "three/examples/jsm/loaders/GLTFLoader.js";

    interface RuntimeModel {
        name: string;
        path: string;
        fullPath: string;
        animation?: string;
    }

    function initializeViewer(root: Element) {
        const canvasContainer = root.querySelector<HTMLElement>(
            "[data-canvas-container]",
        );
        const modelDropdown = root.querySelector<HTMLElement>(
            "[data-model-dropdown]",
        );
        const modelTrigger = root.querySelector<HTMLButtonElement>(
            "[data-model-trigger]",
        );
        const modelMenu = root.querySelector<HTMLElement>("[data-model-menu]");
        const controlsButtons = root.querySelectorAll<HTMLButtonElement>(
            "[data-angle-control]",
        );
        const animationDropdown = root.querySelector<HTMLElement>(
            "[data-animation-dropdown]",
        );
        const animationTrigger = root.querySelector<HTMLButtonElement>(
            "[data-animation-trigger]",
        );
        const animationMenu = root.querySelector<HTMLElement>(
            "[data-animation-menu]",
        );
        const animationLabelModeToggle = root.querySelector<HTMLButtonElement>(
            "[data-animation-full-names-toggle]",
        );
        const viewerStatus = root.querySelector<HTMLElement>(
            "[data-viewer-status]",
        );
        const animationToolsEnabled =
            root.getAttribute("data-enable-animation-tools") === "true";

        if (!canvasContainer) {
            return;
        }

        const modelDataRaw = root.getAttribute("data-models") || "[]";
        const modelData = JSON.parse(modelDataRaw) as RuntimeModel[];

        const showStatus = (message: string) => {
            if (!viewerStatus) return;
            viewerStatus.textContent = message;
            viewerStatus.classList.add("is-visible");
        };

        const hideStatus = () => {
            if (!viewerStatus) return;
            viewerStatus.textContent = "";
            viewerStatus.classList.remove("is-visible");
        };

        if (!Array.isArray(modelData) || modelData.length === 0) {
            showStatus("No models available for this page.");
            console.error("ModelViewer: no model data provided");
            return;
        }

        hideStatus();

        const configureSkyboxTexture = (texture: THREE.CubeTexture) => {
            texture.colorSpace = THREE.SRGBColorSpace;
            texture.magFilter = THREE.LinearFilter;
            texture.minFilter = THREE.LinearMipmapLinearFilter;
            texture.generateMipmaps = true;
            texture.needsUpdate = true;
            return texture;
        };

        const loadSkyboxFromFiles = (paths: string[]) =>
            new Promise<THREE.CubeTexture>((resolve, reject) => {
                const cubeLoader = new THREE.CubeTextureLoader();
                cubeLoader.load(
                    paths,
                    (texture) => {
                        resolve(configureSkyboxTexture(texture));
                    },
                    undefined,
                    (error) => {
                        reject(error);
                    },
                );
            });

        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0x000000);
        const sceneBackgroundControls = scene as THREE.Scene & {
            backgroundBlurriness?: number;
            backgroundIntensity?: number;
        };
        sceneBackgroundControls.backgroundBlurriness = 0.08;
        sceneBackgroundControls.backgroundIntensity = 0.95;

        // Three.js cubemap order: +X, -X, +Y, -Y, +Z, -Z.
        const skyboxFaces = [
            "/skybox/space_rt.png",
            "/skybox/space_lf.png",
            "/skybox/space_up.png",
            "/skybox/space_dn.png",
            "/skybox/space_ft.png",
            "/skybox/space_bk.png",
        ];

        loadSkyboxFromFiles(skyboxFaces)
            .then((skyboxTexture) => {
                scene.background = skyboxTexture;
            })
            .catch((error) => {
                scene.background = new THREE.Color(0x000000);
                console.warn(
                    "ModelViewer: failed to load file skybox, using black background fallback.",
                    error,
                );
            });

        const camera = new THREE.PerspectiveCamera(
            60,
            canvasContainer.clientWidth / canvasContainer.clientHeight,
            0.1,
            2000,
        );
        camera.position.set(3, 3, 3);

        const renderer = new THREE.WebGLRenderer({
            antialias: true,
            alpha: false,
        });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.setSize(
            canvasContainer.clientWidth,
            canvasContainer.clientHeight,
        );
        canvasContainer.appendChild(renderer.domElement);

        const orbitControls = new OrbitControls(camera, renderer.domElement);
        orbitControls.enableDamping = true;
        orbitControls.enablePan = false;
        orbitControls.target.set(0, 1, 0);
        orbitControls.update();

        const ambientLight = new THREE.AmbientLight(0xffffff, 1.4);
        scene.add(ambientLight);

        const keyLight = new THREE.DirectionalLight(0xffffff, 1.2);
        keyLight.position.set(8, 10, 6);
        scene.add(keyLight);

        const fillLight = new THREE.DirectionalLight(0xffffff, 0.6);
        fillLight.position.set(-6, 5, -8);
        scene.add(fillLight);

        const loader = new GLTFLoader();
        let currentModel: THREE.Object3D | null = null;
        let animationMixer: THREE.AnimationMixer | null = null;
        let activeAction: THREE.AnimationAction | null = null;
        let currentAnimations: THREE.AnimationClip[] = [];
        let currentAnimationLabels: string[] = [];
        let showFullAnimationNames = false;
        let selectedAnimationIndex = 0;
        let selectedModelIndex = 0;
        const clock = new THREE.Clock();

        const closeMenu = (
            menu: HTMLElement | null,
            trigger: HTMLButtonElement | null,
        ) => {
            if (!menu || !trigger) return;
            menu.hidden = true;
            trigger.setAttribute("aria-expanded", "false");
        };

        const openMenu = (
            menu: HTMLElement | null,
            trigger: HTMLButtonElement | null,
        ) => {
            if (!menu || !trigger) return;
            menu.hidden = false;
            trigger.setAttribute("aria-expanded", "true");
        };

        const toggleMenu = (
            menu: HTMLElement | null,
            trigger: HTMLButtonElement | null,
        ) => {
            if (!menu || !trigger) return;
            const isOpen = !menu.hidden;
            if (isOpen) {
                closeMenu(menu, trigger);
            } else {
                openMenu(menu, trigger);
            }
        };

        const markSelectedOption = (
            menu: HTMLElement | null,
            dataAttr: string,
            value: string,
        ) => {
            if (!menu) return;
            const options = menu.querySelectorAll<HTMLButtonElement>(
                ".custom-select-option",
            );
            options.forEach((option) => {
                const optionValue = option.getAttribute(dataAttr);
                option.classList.toggle("is-selected", optionValue === value);
            });
        };

        const getAnimationDisplayLabels = (clips: THREE.AnimationClip[]) => {
            if (showFullAnimationNames) {
                return clips.map(
                    (clip, index) => clip.name || `Animation ${index + 1}`,
                );
            }

            const fallbackLabels = clips.map(
                (clip, index) => clip.name || `Animation ${index + 1}`,
            );

            if (clips.length < 2) {
                return fallbackLabels;
            }

            const parsed = clips.map((clip) => {
                const clipName = clip.name;
                if (!clipName || !clipName.startsWith("animation.")) {
                    return null;
                }

                const lastDotIndex = clipName.lastIndexOf(".");
                const prefix = clipName.slice(0, lastDotIndex + 1);
                const shortName = clipName.slice(lastDotIndex + 1);

                if (prefix === "animation." || shortName.length === 0) {
                    return null;
                }

                return {
                    prefix,
                    shortName,
                };
            });

            if (parsed.some((entry) => entry === null)) {
                return fallbackLabels;
            }

            const sharedPrefix = parsed[0]!.prefix;
            const hasSharedPrefix = parsed.every(
                (entry) => entry!.prefix === sharedPrefix,
            );

            if (!hasSharedPrefix) {
                return fallbackLabels;
            }

            return parsed.map((entry) => entry!.shortName);
        };

        const populateAnimationMenu = (
            selectedIndex: number,
            selectedLabel?: string,
        ) => {
            if (!animationToolsEnabled || !animationMenu || !animationTrigger) {
                return;
            }

            animationMenu.innerHTML = "";

            currentAnimations.forEach((clip, index) => {
                const option = document.createElement("button");
                option.type = "button";
                option.className = "custom-select-option";
                option.setAttribute("data-animation-index", String(index));
                option.textContent =
                    currentAnimationLabels[index] ||
                    clip.name ||
                    `Animation ${index + 1}`;
                animationMenu.appendChild(option);
            });

            if (currentAnimations.length > 0) {
                animationTrigger.textContent =
                    selectedLabel ||
                    currentAnimationLabels[selectedIndex] ||
                    currentAnimations[selectedIndex]?.name ||
                    `Animation ${selectedIndex + 1}`;
                markSelectedOption(
                    animationMenu,
                    "data-animation-index",
                    String(selectedIndex),
                );
            }
        };

        const setAnimationControlsState = () => {
            if (
                !animationToolsEnabled ||
                !animationDropdown ||
                !animationTrigger ||
                !animationMenu
            ) {
                return;
            }

            if (animationLabelModeToggle) {
                animationLabelModeToggle.disabled =
                    currentAnimations.length === 0;
            }

            const hasAnimations = currentAnimations.length > 0;
            if (!hasAnimations) {
                animationDropdown.hidden = true;
                closeMenu(animationMenu, animationTrigger);
                animationMenu.innerHTML = "";
                animationTrigger.disabled = true;
                animationTrigger.textContent = "Select animation";
            } else {
                animationDropdown.hidden = false;
                animationTrigger.disabled = false;
            }
        };

        const playAnimationClip = (clip: THREE.AnimationClip) => {
            if (!currentModel) return;

            if (!animationMixer) {
                animationMixer = new THREE.AnimationMixer(currentModel);
            }

            if (activeAction) {
                activeAction.stop();
                activeAction = null;
            }

            activeAction = animationMixer.clipAction(clip);
            activeAction.reset();
            activeAction.play();
        };

        const resetCamera = () => {
            camera.position.set(3, 3, 3);
            orbitControls.update();
        };

        const frameModel = (object3D: THREE.Object3D) => {
            const box = new THREE.Box3().setFromObject(object3D);
            const size = box.getSize(new THREE.Vector3());
            const center = box.getCenter(new THREE.Vector3());

            const maxDim = Math.max(size.x, size.y, size.z) || 1;
            const fitDistance = maxDim * 1.6;

            orbitControls.target.copy(center);
            camera.position.set(
                center.x + fitDistance,
                center.y + fitDistance * 0.65,
                center.z + fitDistance,
            );
            camera.near = Math.max(0.01, fitDistance / 100);
            camera.far = fitDistance * 100;
            camera.updateProjectionMatrix();
            orbitControls.update();
        };

        const disposeModel = (model: THREE.Object3D) => {
            model.traverse((child: THREE.Object3D) => {
                if ("isMesh" in child && child.isMesh) {
                    const mesh = child as THREE.Mesh;
                    if (mesh.geometry) mesh.geometry.dispose();
                    if (Array.isArray(mesh.material)) {
                        mesh.material.forEach(
                            (mat: THREE.Material) =>
                                mat.dispose && mat.dispose(),
                        );
                    } else if (mesh.material) {
                        mesh.material.dispose && mesh.material.dispose();
                    }
                }
            });
        };

        const loadModelAtIndex = (index: number) => {
            const model = modelData[index];
            if (!model) return;

            selectedModelIndex = index;
            if (modelTrigger) {
                modelTrigger.textContent = model.name;
            }
            markSelectedOption(modelMenu, "data-model-index", String(index));

            loader.load(
                model.fullPath,
                (gltf) => {
                    hideStatus();

                    if (activeAction) {
                        activeAction.stop();
                        activeAction = null;
                    }

                    if (currentModel) {
                        if (animationMixer) {
                            animationMixer.stopAllAction();
                            animationMixer.uncacheRoot(currentModel);
                            animationMixer = null;
                        }

                        scene.remove(currentModel);
                        disposeModel(currentModel);
                    }

                    currentModel = gltf.scene;
                    scene.add(currentModel);
                    frameModel(currentModel);

                    currentAnimations = gltf.animations || [];
                    currentAnimationLabels =
                        getAnimationDisplayLabels(currentAnimations);
                    setAnimationControlsState();

                    // Play requested animation clip by name, or fallback to first clip
                    if (currentAnimations.length > 0) {
                        const requestedAnimationName = model.animation;
                        const requestedClip = requestedAnimationName
                            ? THREE.AnimationClip.findByName(
                                  currentAnimations,
                                  requestedAnimationName,
                              )
                            : null;

                        const selectedClip =
                            requestedClip || currentAnimations[0];
                        const selectedClipIndex = Math.max(
                            0,
                            currentAnimations.indexOf(selectedClip),
                        );
                        selectedAnimationIndex = selectedClipIndex;

                        if (requestedAnimationName && !requestedClip) {
                            console.warn(
                                `ModelViewer: animation \"${requestedAnimationName}\" not found for ${model.name}. Falling back to first clip.`,
                            );
                        }

                        playAnimationClip(selectedClip);
                        populateAnimationMenu(
                            selectedClipIndex,
                            currentAnimationLabels[selectedClipIndex] ||
                                selectedClip.name ||
                                "Animation 1",
                        );
                    }
                },
                undefined,
                (error) => {
                    showStatus(`Unable to load model: ${model.name}`);
                    console.error(
                        `ModelViewer: failed to load ${model.fullPath}`,
                        error,
                    );
                },
            );
        };

        if (modelTrigger && modelMenu) {
            modelTrigger.addEventListener("click", () => {
                closeMenu(animationMenu, animationTrigger);
                toggleMenu(modelMenu, modelTrigger);
            });

            modelMenu.addEventListener("click", (event) => {
                const target = event.target as HTMLElement;
                const button =
                    target.closest<HTMLButtonElement>("[data-model-index]");
                if (!button) return;

                const selectedIndex = Number(
                    button.getAttribute("data-model-index"),
                );
                loadModelAtIndex(selectedIndex);
                closeMenu(modelMenu, modelTrigger);
            });
        }

        if (animationToolsEnabled && animationTrigger && animationMenu) {
            animationTrigger.addEventListener("click", () => {
                if (currentAnimations.length === 0) {
                    return;
                }
                closeMenu(modelMenu, modelTrigger);
                toggleMenu(animationMenu, animationTrigger);
            });

            animationMenu.addEventListener("click", (event) => {
                const target = event.target as HTMLElement;
                const button = target.closest<HTMLButtonElement>(
                    "[data-animation-index]",
                );
                if (!button) return;

                const selectedIndex = Number(
                    button.getAttribute("data-animation-index"),
                );
                const selectedClip = currentAnimations[selectedIndex];
                if (selectedClip) {
                    selectedAnimationIndex = selectedIndex;
                    playAnimationClip(selectedClip);
                    animationTrigger.textContent =
                        currentAnimationLabels[selectedIndex] ||
                        selectedClip.name ||
                        `Animation ${selectedIndex + 1}`;
                    markSelectedOption(
                        animationMenu,
                        "data-animation-index",
                        String(selectedIndex),
                    );
                }

                closeMenu(animationMenu, animationTrigger);
            });

            animationLabelModeToggle?.addEventListener("click", () => {
                showFullAnimationNames = !showFullAnimationNames;
                animationLabelModeToggle.setAttribute(
                    "aria-pressed",
                    String(showFullAnimationNames),
                );
                currentAnimationLabels =
                    getAnimationDisplayLabels(currentAnimations);

                if (currentAnimations.length === 0) {
                    return;
                }

                selectedAnimationIndex = Math.min(
                    selectedAnimationIndex,
                    currentAnimations.length - 1,
                );
                const currentLabel =
                    currentAnimationLabels[selectedAnimationIndex] ||
                    currentAnimations[selectedAnimationIndex]?.name ||
                    "Animation 1";
                populateAnimationMenu(selectedAnimationIndex, currentLabel);
            });
        }

        document.addEventListener("click", (event) => {
            const target = event.target as Node;
            if (modelDropdown && !modelDropdown.contains(target)) {
                closeMenu(modelMenu, modelTrigger);
            }
            if (animationDropdown && !animationDropdown.contains(target)) {
                closeMenu(animationMenu, animationTrigger);
            }
        });

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape") {
                closeMenu(modelMenu, modelTrigger);
                closeMenu(animationMenu, animationTrigger);
            }
        });

        controlsButtons.forEach((button) => {
            button.addEventListener("click", () => {
                const action = button.getAttribute("data-angle-control");
                const step = Math.PI / 10;

                if (action === "left") orbitControls.rotateLeft(step);
                if (action === "right") orbitControls.rotateLeft(-step);
                if (action === "up") orbitControls.rotateUp(step / 1.5);
                if (action === "down") orbitControls.rotateUp(-step / 1.5);
                if (action === "reset") resetCamera();

                orbitControls.update();
            });
        });

        const onResize = () => {
            camera.aspect =
                canvasContainer.clientWidth / canvasContainer.clientHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(
                canvasContainer.clientWidth,
                canvasContainer.clientHeight,
            );
        };

        window.addEventListener("resize", onResize);

        setAnimationControlsState();
        loadModelAtIndex(0);

        const animate = () => {
            requestAnimationFrame(animate);

            const delta = clock.getDelta();
            if (animationMixer) {
                animationMixer.update(delta);
            }

            orbitControls.update();
            renderer.render(scene, camera);
        };
        animate();
    }

    document.querySelectorAll("[data-model-viewer]").forEach((root) => {
        initializeViewer(root);
    });
</script>
